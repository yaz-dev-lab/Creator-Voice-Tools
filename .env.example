# --- App ---
APP_URL=http://localhost:3000
# Random 32+ char secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Database (Postgres, via Prisma) ---
DATABASE_URL=postgresql://user:password@localhost:5432/creator_voice_tools

# --- Stripe ---
# Test-mode secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder
# From `stripe listen` locally, or the webhook's signing secret in the
# Stripe dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Email (Resend) ---
# Leave unset to log emails to the console instead of sending them.
RESEND_API_KEY=
EMAIL_FROM="Creator Voice Tools <onboarding@resend.dev>"
