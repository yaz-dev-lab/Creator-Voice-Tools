# ── Server ────────────────────────────────────────────────────
PORT=3000
# Full public URL of your site (no trailing slash)
BASE_URL=https://yourdomain.com

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# ── Stripe ────────────────────────────────────────────────────
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# From https://dashboard.stripe.com/webhooks  (add endpoint BASE_URL/api/webhooks/stripe)
# Events to subscribe: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Voice files ───────────────────────────────────────────────
# Place zipped preset files in ./voices/
# Naming: voices/<ExactVoiceName>.zip  (e.g. voices/Peterbot.zip)
